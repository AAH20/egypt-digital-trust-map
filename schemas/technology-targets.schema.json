{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a2zsoc.com/schemas/digital-trust-technology-targets.schema.json",
  "title": "Digital Trust Technology Integration Targets",
  "type": "object",
  "required": ["registry_id", "coverage_note", "targets"],
  "properties": {
    "registry_id": {"type": "string", "minLength": 1},
    "coverage_note": {"type": "string", "minLength": 1},
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "domains", "classification", "validation_state"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "domains": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "classification": {"type": "string", "minLength": 1},
          "validation_state": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
