{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a2zsoc.com/schemas/egypt-sector-ecosystem.schema.json",
  "title": "Egypt Public Sector Ecosystem Registry",
  "type": "object",
  "required": ["registry_id", "last_verified", "coverage_note", "sources", "groups"],
  "properties": {
    "registry_id": {"type": "string", "minLength": 1},
    "last_verified": {"type": "string", "format": "date"},
    "coverage_note": {"type": "string", "minLength": 1},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "url", "scope"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "url": {"type": "string", "pattern": "^https://"},
          "scope": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "records"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "source_id": {"type": "string", "minLength": 1},
          "records": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "name", "role", "evidence_state"],
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "name": {"type": "string", "minLength": 1},
                "role": {"type": "string", "minLength": 1},
                "evidence_state": {"type": "string", "minLength": 1},
                "reason": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
