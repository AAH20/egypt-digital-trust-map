{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a2zsoc.com/schemas/egypt-sovereignty-assessment.schema.json",
  "title": "Egypt Sovereign IAM/PAM Assessment",
  "type": "object",
  "required": ["assessment_id", "profile_id", "subject", "scores", "gates", "evidence", "limitations"],
  "properties": {
    "assessment_id": {"type": "string", "minLength": 3},
    "profile_id": {"type": "string", "minLength": 3},
    "subject": {"type": "string", "minLength": 3},
    "scores": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0}},
    "gates": {"type": "object", "additionalProperties": {"type": "boolean"}},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "additionalProperties": false
}
