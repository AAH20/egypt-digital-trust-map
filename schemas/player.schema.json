{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a2zsoc.com/schemas/egypt-digital-trust-player.schema.json",
  "title": "Egypt Digital Trust Player",
  "type": "object",
  "required": ["id", "name", "player_types", "capabilities", "source_status", "sources", "last_verified"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "name": {"type": "string", "minLength": 2},
    "player_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "source_status": {"enum": ["authoritative", "authoritative-listing", "authoritative-listing-and-first-party-claim", "first-party-claim", "independently-tested"]},
    "sources": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "format": "uri"}},
    "last_verified": {"type": "string", "format": "date"}
  },
  "additionalProperties": false
}
