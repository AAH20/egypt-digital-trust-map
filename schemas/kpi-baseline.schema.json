{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a2zsoc.com/schemas/egypt-digital-trust-kpi-baseline.schema.json",
  "title": "Egypt Digital Trust KPI Baseline",
  "type": "object",
  "required": ["baseline_id", "status", "scope", "kpis"],
  "properties": {
    "baseline_id": {"type": "string", "minLength": 1},
    "status": {"const": "reference-baseline"},
    "scope": {"type": "string", "minLength": 1},
    "kpis": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "family", "name", "operator", "target", "unit", "measurement"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "family": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "operator": {"enum": ["eq", "lte", "gte"]},
          "target": {"type": "number"},
          "unit": {"type": "string", "minLength": 1},
          "measurement": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
