{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a2zsoc.com/schemas/egypt-digital-trust-evidence-manifest.schema.json",
  "title": "Egypt Digital Trust Evidence Manifest",
  "type": "object",
  "required": ["manifest_id", "subject_id", "control_ids", "environment", "artifacts", "observed_at", "assessor", "limitations"],
  "properties": {
    "manifest_id": {"type": "string", "minLength": 3},
    "subject_id": {"type": "string", "minLength": 2},
    "control_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "environment": {"type": "string", "minLength": 2},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "sha256", "classification"],
        "properties": {
          "name": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "classification": {"enum": ["public", "restricted", "confidential", "secret-reference-only"]}
        },
        "additionalProperties": false
      }
    },
    "observed_at": {"type": "string", "format": "date-time"},
    "assessor": {"type": "string", "minLength": 2},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "additionalProperties": false
}
